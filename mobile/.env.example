# Endereços dos serviços locais usados pelo app (copie para mobile/.env).
# Sem este arquivo, o app usa os valores abaixo (localhost).
#
# - Emulador Android: mantenha localhost e rode "npm run android:portas" na raiz
# - Navegador (Expo Web) / iOS Simulator: localhost funciona direto
# - Celular físico via Wi-Fi: troque localhost pelo IP do computador (ex.: 192.168.0.10)
#   e ajuste também S3_PUBLIC_URL no .env da raiz
#
# Depois de alterar, reinicie o Expo com: npx expo start -c
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_IA_URL=http://localhost:8001
EXPO_PUBLIC_S3_URL=http://localhost:8080
