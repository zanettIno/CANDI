# ─────────────────────────────────────────────────────────────────────────────
# CANDI — variáveis do ambiente local (docker-compose)
# Copie para ".env" (na raiz do monorepo) e preencha o que for necessário.
# ─────────────────────────────────────────────────────────────────────────────

# ── API de IA (Google Gemini) ─ OBRIGATÓRIO para o "Relatório de Saúde" ──────
# Chave gerada em https://aistudio.google.com/apikey
CHAVE_API=
# Sal usado para anonimizar o profile_id antes de enviar dados ao Gemini
ANONYMIZATION_SALT=troque_este_sal

# ── Autenticação (JWT) ───────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=troque_access_secret
REFRESH_TOKEN_SECRET=troque_refresh_secret
COOKIE_SECRET=troque_cookie_secret
# Senha para criar conta admin pelo cadastro (campo adminSecret)
ADMIN_SECRET=candi_admin_2026

# ── E-mail (convites da rede de apoio e recuperação de senha) ───────────────
# Gmail com "Senha de app" (não use a senha real da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── Endereços vistos pelo app ────────────────────────────────────────────────
# URL usada nas imagens de posts/grupos gravadas no banco.
# - Emulador Android (com "npm run android:portas"), iOS Simulator ou navegador: http://localhost:8080
# - Celular físico pela rede Wi-Fi: http://<IP-do-computador>:8080
S3_PUBLIC_URL=http://localhost:8080
# Link usado nos e-mails de convite
APP_URL=http://localhost:8081
